---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {getCollection} from 'astro:content';
import {path} from '../../site';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);const tags=[...new Set(posts.flatMap(post=>post.data.tags))];return tags.map(tag=>({params:{tag},props:{tag,posts:posts.filter(post=>post.data.tags.includes(tag))}}));}
const {tag,posts}=Astro.props;
---
<BaseLayout title={`标签：${tag}`}><section class="container inner-page"><a class="inline-link" href={path('/blog/')}>← 所有文章</a><div class="kicker" style="margin-top:32px">TAG / ARCHIVE</div><h1>#{tag}<span>.</span></h1><p class="page-intro">与 {tag} 相关的文章。</p><div class="card-grid">{posts.map(post=><PostCard post={post}/>)}</div></section></BaseLayout>
