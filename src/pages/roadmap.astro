---
import BaseLayout from '../layouts/BaseLayout.astro';
const steps=[{title:'编程语言与计算机基础',description:'Java 基础、面向对象、集合、泛型、并发、算法、网络与操作系统',tags:['Java','数据结构','计算机网络']},{title:'数据库与服务端开发',description:'MySQL、Redis、Spring Boot、RESTful API、认证鉴权、自动化测试',tags:['Spring Boot','MySQL','Redis']},{title:'前端与全栈协作',description:'HTML/CSS、JavaScript、TypeScript、Vue、前后端接口联调',tags:['JavaScript','TypeScript','Vue']},{title:'DevOps 与工程实践',description:'Git、Linux、Docker、CI/CD、部署、日志排查、监控与项目复盘',tags:['Git','Docker','GitHub Actions']}];
---
<BaseLayout title="学习路线"><section class="container inner-page"><div class="kicker">ROADMAP / LEARNING</div><h1>学习路线<span>.</span></h1><p class="page-intro">以开发能力为目标，将学习拆分成可实践、可复盘的四个阶段。这里展示的是建议顺序，不代表已完成进度。</p><div class="roadmap-list">{steps.map((step,i)=><section class="roadmap-step"><div class="step-index">0{i+1}</div><div><h2>{step.title}</h2><p>{step.description}</p><div class="pills">{step.tags.map(t=><span>{t}</span>)}</div></div><span class="step-status">学习阶段</span></section>)}</div></section></BaseLayout>
