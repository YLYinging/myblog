---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getProjects } from '../projects';
import { path } from '../site';

const publishedPosts = await getCollection('blog', ({ data }) => !data.draft);
const publishedIds = new Set(publishedPosts.map(post => post.id));
const projects = await Promise.all((await getProjects()).map(async entry => ({
  id: entry.id,
  ...entry.data,
  Content: entry.body?.trim() ? (await render(entry)).Content : undefined,
})));
---

<BaseLayout title="项目作品">
  <section class="container inner-page">
    <div class="kicker">SELECTED WORK / PROJECTS</div>
    <h1>项目与作品<span>.</span></h1>
    <p class="page-intro">将学到的知识用于真实实践，记录成果和下一步。</p>
    <div class="projects-page-grid">
      {projects.map((project, index) => (
        <article class:list={['project-tile', { 'is-planned': project.status === '计划中' }]} data-reveal id={project.id}>
          {project.status !== '计划中' && (project.cover ? (
            <img class="project-preview" src={path(project.cover)} alt={`${project.title}预览`} width="960" height="500" />
          ) : (
            <div class={`project-tile-art art-tone-${(index % 3) + 1}`} aria-hidden="true">
              <span>PROJECT / {String(index + 1).padStart(2, '0')}</span>
              <strong>{project.label || project.title.slice(0, 2)}</strong>
            </div>
          ))}
          <div class="project-tile-body">
            <div class="project-label">{project.status}</div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            {project.milestone && <p><strong>下一步</strong> {project.milestone}</p>}
            {project.Content && (project.status === '计划中' ? <details><summary>查看计划详情</summary><div class="prose"><project.Content /></div></details> : <div class="prose"><project.Content /></div>)}
            {project.tech.length > 0 && <div class="pills">{project.tech.map(tech => <span>{tech}</span>)}</div>}
            <div class="project-links">
              {project.repository && <a class="inline-link" href={project.repository}>查看源码 ↗</a>}
              {project.note && publishedIds.has(project.note) && (
                <a class="inline-link" href={path(`/blog/${project.note}/`)}>阅读搭建笔记 →</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page-grid { align-items: start; }
  .is-planned { background: transparent; }
  .is-planned h2 { font-size: 20px; }
  .is-planned .project-tile-body { padding: 20px; }
  .project-preview { display: block; width: 100%; height: 210px; object-fit: cover; object-position: top; }
  .project-tile-art strong { font-size: clamp(38px, 7vw, 76px); letter-spacing: -0.06em; }
  .project-links { display: flex; gap: 16px; flex-wrap: wrap; }
</style>
